#============= fsck ==============
allow fsck self:capability kill;
allow fsck vendor_modem_efs_partition_device:blk_file open;



#============= init ==============
allow init hidl_base_hwservice:hwservice_manager add;
allow init hwservicemanager:binder { call transfer };

#!!!! This avc is allowed in the current policy
allow init same_process_hal_file:file execute;

#!!!! This avc is allowed in the current policy
allow init vendor_file:file execute;
allow init vendor_modem_efs_partition_device:lnk_file relabelto;



#============= tee ==============
allow tee tmpfs:dir read;

#============= untrusted_app ==============
allow untrusted_app aac_drc_prop:file { getattr map open };
allow untrusted_app ab_update_gki_prop:file { getattr open };
allow untrusted_app proc_zoneinfo:file { getattr open };


#============= vdc ==============
allow vdc self:capability kill;


